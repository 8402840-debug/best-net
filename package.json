{
  "name": "card-vault",
  "version": "1.0.0",
  "description": "卡片保险柜 - 本地卡片管理工具",
  "main": "main.js",
  "author": "CardVault",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cardvault.app",
    "productName": "CardVault",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "card-vault.html",
      "icon.ico"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
